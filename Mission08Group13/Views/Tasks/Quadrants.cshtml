@model IEnumerable<Mission08Group13.Models.TaskItem>

@{
    ViewData["Title"] = "Quadrants";
}

<div class="container">
  <div class="row mb-3">
    <div class="col-12">
      <h1>Task Quadrants</h1>
      <p class="lead">Important/Urgent matrix — lists incomplete tasks grouped into 4 quadrants.</p>
    </div>
  </div>
  
  <div class="row">
    <!-- Quadrant 1 (Important & Urgent) -->
    <div class="col-md-6 mb-4" role="region" aria-labelledby="q1-heading">
      <div class="card h-100">
        <div class="card-header" id="q1-heading">
          <h2 class="h5">Quadrant 1 — Important &amp; Urgent</h2>
          <small class="text-muted">Due soon or overdue</small>
        </div>
        <div class="card-body">
          @foreach (var task in Model.Where(t => t.Quadrant == 1))
          {
            <div class="task-card mb-2">
              <div class="d-flex justify-content-between align-items-start">
                <div>
                  <h4 class="mb-1">@task.Name</h4>
                  <div class="small text-muted">@task.Category — Due: @(task.DueDate?.ToString("yyyy-MM-dd") ?? "—")</div>
                </div>
                <div class="btn-group btn-group-sm" role="group" aria-label="task actions">
                  <a asp-controller="Tasks" asp-action="Create" asp-route-id="@task.Id" class="btn btn-outline-secondary">Edit</a>
                  <form method="post" asp-controller="Tasks" asp-action="Complete" asp-route-id="@task.Id" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-success">Complete</button>
                  </form>
                  <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#confirmDeleteModal" data-taskid="@task.Id" data-taskname="@task.Name" data-taskdue="@(task.DueDate?.ToString("yyyy-MM-dd") ?? "—")">Delete</button>
                </div>
              </div>
            </div>
          }
          @if (!Model.Any(t => t.Quadrant == 1))
          {
            <p class="text-muted">No tasks in this quadrant.</p>
          }
        </div>
      </div>
    </div>

    <!-- Quadrant 2 (Important & Not Urgent) -->
    <div class="col-md-6 mb-4" role="region" aria-labelledby="q2-heading">
      <div class="card h-100">
        <div class="card-header" id="q2-heading">
          <h2 class="h5">Quadrant 2 — Important &amp; Not Urgent</h2>
          <small class="text-muted">Plan and schedule</small>
        </div>
        <div class="card-body">
          @foreach (var task in Model.Where(t => t.Quadrant == 2))
          {
            <div class="task-card mb-2">
              <div class="d-flex justify-content-between align-items-start">
                <div>
                  <h4 class="mb-1">@task.Name</h4>
                  <div class="small text-muted">@task.Category — Due: @(task.DueDate?.ToString("yyyy-MM-dd") ?? "—")</div>
                </div>
                <div class="btn-group btn-group-sm" role="group" aria-label="task actions">
                  <a asp-controller="Tasks" asp-action="Create" asp-route-id="@task.Id" class="btn btn-outline-secondary">Edit</a>
                  <form method="post" asp-controller="Tasks" asp-action="Complete" asp-route-id="@task.Id" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-success">Complete</button>
                  </form>
                  <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#confirmDeleteModal" data-taskid="@task.Id" data-taskname="@task.Name" data-taskdue="@(task.DueDate?.ToString("yyyy-MM-dd") ?? "—")">Delete</button>
                </div>
              </div>
            </div>
          }
          @if (!Model.Any(t => t.Quadrant == 2))
          {
            <p class="text-muted">No tasks in this quadrant.</p>
          }
        </div>
      </div>
    </div>
  </div>
  
  <div class="row">
    <!-- Quadrant 3 (Not Important & Urgent) -->
    <div class="col-md-6 mb-4" role="region" aria-labelledby="q3-heading">
      <div class="card h-100">
        <div class="card-header" id="q3-heading">
          <h2 class="h5">Quadrant 3 — Not Important &amp; Urgent</h2>
          <small class="text-muted">Delegate or handle quickly</small>
        </div>
        <div class="card-body">
          @foreach (var task in Model.Where(t => t.Quadrant == 3))
          {
            <div class="task-card mb-2">
              <div class="d-flex justify-content-between align-items-start">
                <div>
                  <h4 class="mb-1">@task.Name</h4>
                  <div class="small text-muted">@task.Category — Due: @(task.DueDate?.ToString("yyyy-MM-dd") ?? "—")</div>
                </div>
                <div class="btn-group btn-group-sm" role="group" aria-label="task actions">
                  <a asp-controller="Tasks" asp-action="Create" asp-route-id="@task.Id" class="btn btn-outline-secondary">Edit</a>
                  <form method="post" asp-controller="Tasks" asp-action="Complete" asp-route-id="@task.Id" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-success">Complete</button>
                  </form>
                  <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#confirmDeleteModal" data-taskid="@task.Id" data-taskname="@task.Name" data-taskdue="@(task.DueDate?.ToString("yyyy-MM-dd") ?? "—")">Delete</button>
                </div>
              </div>
            </div>
          }
          @if (!Model.Any(t => t.Quadrant == 3))
          {
            <p class="text-muted">No tasks in this quadrant.</p>
          }
        </div>
      </div>
    </div>

    <!-- Quadrant 4 (Not Important & Not Urgent) -->
    <div class="col-md-6 mb-4" role="region" aria-labelledby="q4-heading">
      <div class="card h-100">
        <div class="card-header" id="q4-heading">
          <h2 class="h5">Quadrant 4 — Not Important &amp; Not Urgent</h2>
          <small class="text-muted">Low priority</small>
        </div>
        <div class="card-body">
          @foreach (var task in Model.Where(t => t.Quadrant == 4))
          {
            <div class="task-card mb-2">
              <div class="d-flex justify-content-between align-items-start">
                <div>
                  <h4 class="mb-1">@task.Name</h4>
                  <div class="small text-muted">@task.Category — Due: @(task.DueDate?.ToString("yyyy-MM-dd") ?? "—")</div>
                </div>
                <div class="btn-group btn-group-sm" role="group" aria-label="task actions">
                  <a asp-controller="Tasks" asp-action="Create" asp-route-id="@task.Id" class="btn btn-outline-secondary">Edit</a>
                  <form method="post" asp-controller="Tasks" asp-action="Complete" asp-route-id="@task.Id" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-success">Complete</button>
                  </form>
                  <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#confirmDeleteModal" data-taskid="@task.Id" data-taskname="@task.Name" data-taskdue="@(task.DueDate?.ToString("yyyy-MM-dd") ?? "—")">Delete</button>
                </div>
              </div>
            </div>
          }
          @if (!Model.Any(t => t.Quadrant == 4))
          {
            <p class="text-muted">No tasks in this quadrant.</p>
          }
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Confirmation modal (single modal reused for all deletes) -->
<div class="modal fade" id="confirmDeleteModal" tabindex="-1" role="dialog" aria-labelledby="confirmDeleteLabel" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="confirmDeleteLabel">Confirm Delete</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p>Are you sure you want to delete <strong id="modal-task-title">[Task Title]</strong> (Due: <span id="modal-task-due">[Due]</span>)?</p>
      </div>
      <div class="modal-footer">
        <form method="post" id="modal-delete-form" action="">
          @Html.AntiForgeryToken()
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-danger">Delete</button>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  document.getElementById('confirmDeleteModal').addEventListener('show.bs.modal', function (event) {
    var button = event.relatedTarget;
    if (button && button.getAttribute('data-taskid')) {
      var id = button.getAttribute('data-taskid');
      var name = button.getAttribute('data-taskname') || '[Task Title]';
      var due = button.getAttribute('data-taskdue') || '[Due]';
      var form = document.getElementById('modal-delete-form');
      form.action = '/Tasks/Delete/' + id;
      document.getElementById('modal-task-title').textContent = name;
      document.getElementById('modal-task-due').textContent = due;
    }
  });
</script>
