@model IEnumerable<Mission08Group13.Models.TaskItem>

@{
    ViewData["Title"] = "Quadrants";
}

<div class="container">
  <div class="row mb-3">
    <div class="col-12">
      <h1>Task Quadrants</h1>
      <p class="lead">Important/Urgent matrix — lists incomplete tasks grouped into 4 quadrants.</p>
    </div>
  </div>
  
  <div class="row">
    <!-- Quadrant 1 (Important & Urgent) -->
    <div class="col-md-6 mb-4" role="region" aria-labelledby="q1-heading">
      <div class="card h-100">
        <div class="card-header" id="q1-heading">
          <h2 class="h5">Quadrant 1 — Important &amp; Urgent</h2>
          <small class="text-muted">Due soon or overdue</small>
        </div>
        <div class="card-body">
          
          <!-- Example loop placeholder -->
          @* foreach (var task in Model.Quadrant1) { *@
          
            <div class="task-card mb-2">
              <div class="d-flex justify-content-between align-items-start">
                <div>
                  <h4 class="mb-1">Task Title</h4>
                  <div class="small text-muted">Category — Due: 2026-03-01</div>
                </div>
                <div class="btn-group btn-group-sm" role="group" aria-label="task actions">
                  <!-- Edit: simple anchor to Edit page -->
                  <a href="/Tasks/Edit/123" class="btn btn-outline-secondary">Edit</a>
                  
                  <form method="post" action="/Tasks/Complete/123" class="d-inline">
                    @* @Html.AntiForgeryToken() *@
                    <button type="submit" class="btn btn-outline-success">Complete</button>
                  </form>

                  <!-- Delete: triggered via modal or direct form submit -->
                  <button type="button" class="btn btn-outline-danger" data-toggle="modal" data-target="#confirmDeleteModal" data-taskid="123">Delete</button>
                </div>
              </div>
              <!-- optional: truncated description -->
              <p class="mt-2 mb-0 text-truncate">Short description…</p>
            </div>
          @* } *@

          <!-- If no tasks -->
          <!-- <p class="text-muted">No tasks in this quadrant.</p> -->
        </div>
      </div>
    </div>

    <!-- Quadrant 2 (Important & Not Urgent) -->
    <div class="col-md-6 mb-4" role="region" aria-labelledby="q2-heading">
      <div class="card h-100">
        <div class="card-header" id="q2-heading">
          <h2 class="h5">Quadrant 2 — Important &amp; Not Urgent</h2>
          <small class="text-muted">Plan and schedule</small>
        </div>
        <div class="card-body">
          <!-- foreach tasks for quadrant 2, same partial -->
        </div>
      </div>
    </div>
  </div>
  
  <div class="row">
    <!-- Quadrant 3 (Not Important & Urgent) -->
    <div class="col-md-6 mb-4" role="region" aria-labelledby="q3-heading">
      <div class="card h-100">
        <div class="card-header" id="q3-heading">
          <h2 class="h5">Quadrant 3 — Not Important &amp; Urgent</h2>
          <small class="text-muted">Delegate or handle quickly</small>
        </div>
        <div class="card-body">
          <!-- foreach tasks for quadrant 3 -->
        </div>
      </div>
    </div>

    <!-- Quadrant 4 (Not Important & Not Urgent) -->
    <div class="col-md-6 mb-4" role="region" aria-labelledby="q4-heading">
      <div class="card h-100">
        <div class="card-header" id="q4-heading">
          <h2 class="h5">Quadrant 4 — Not Important &amp; Not Urgent</h2>
          <small class="text-muted">Low priority</small>
        </div>
        <div class="card-body">
          <!-- foreach tasks for quadrant 4 -->
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Confirmation modal (single modal reused for all deletes) -->
<div class="modal fade" id="confirmDeleteModal" tabindex="-1" role="dialog" aria-labelledby="confirmDeleteLabel" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="confirmDeleteLabel">Confirm Delete</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">&times;</button>
      </div>
      <div class="modal-body">
        <p>Are you sure you want to delete <strong id="modal-task-title">[Task Title]</strong> (Due: <span id="modal-task-due">[Due]</span>)?</p>
      </div>
      <div class="modal-footer">
        <form method="post" id="modal-delete-form" action="/Tasks/Delete/123">
          @* @Html.AntiForgeryToken() *@
          <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-danger">Delete</button>
        </form>
      </div>
    </div>
  </div>
</div>
